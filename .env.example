# Google Gemini API Key (Required for Google AI Studio / Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here

# GCP Project & Region (Optional for Vertex AI backend)
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1

# Application Config
LOG_LEVEL=INFO
APP_ENV=development
PERSISTENCE_DB_PATH=wedding_planner_sessions.db
